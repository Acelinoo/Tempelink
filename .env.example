# --- PINTEREST PROVIDER ---
PINTEREST_PROVIDER_API_KEY=
PINTEREST_PROVIDER_API_HOST=pinterest-media-download1.p.rapidapi.com
PINTEREST_PROVIDER_BASE_URL=https://pinterest-media-download1.p.rapidapi.com
