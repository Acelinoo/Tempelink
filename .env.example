# ==============================================================================
# TEMPELINK ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# NOTE: Never commit real credentials or secrets to version control.
# Copy this file to .env.local for local development.

# ==============================================================================
# 1. SERVER RUNTIME & GENERAL (DEVELOPMENT DEFAULTS)
# ==============================================================================
# [Development-only] Runtime environment (development / production / test)
NODE_ENV=development
# [Development-only] Local server listening port
PORT=3000

# ==============================================================================
# 2. PUBLIC CLIENT CONFIG (REQUIRED)
# ==============================================================================
NEXT_PUBLIC_APP_NAME="Tempelink"
NEXT_PUBLIC_APP_DESCRIPTION="Universal Media Downloader & Capability Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# 3. SECURITY & CRYPTOGRAPHY (REQUIRED IN PRODUCTION)
# ==============================================================================
# [REQUIRED IN PRODUCTION] 32+ character high-entropy secret for HMAC-SHA256 download token signing
DOWNLOAD_SIGNING_SECRET=tempelink_dev_secret_signing_key_32_chars
# [Optional] Expiration window for signed media download URLs (seconds)
DOWNLOAD_TOKEN_EXPIRY_SECONDS=900

# [Optional] Strict local SSRF IP blocking (127.0.0.1, AWS 169.254.169.254, internal ranges)
SSRF_ENFORCE_STRICT_LOCAL_BLOCK=true
# [Optional] Allowed URL protocols for input and media fetching
SSRF_ALLOWED_PROTOCOLS=http,https

# ==============================================================================
# 4. DATABASE & DISTRIBUTED QUEUE STORAGE (PHASE 9)
# ==============================================================================
# [Development-only] Local fallback: 'file' (disk-backed in .data/batches)
# [REQUIRED IN PRODUCTION] Set to 'postgres' for distributed multi-instance durability on Vercel
BATCH_STORE_DRIVER=file

# [REQUIRED IN PRODUCTION] PostgreSQL connection URI (e.g. Neon serverless connection string)
# If left empty in production, the application will fail fast to prevent silent loss of durability.
DATABASE_URL=
# [Optional] Enable SSL mode for PostgreSQL connection
DATABASE_SSL=true

# ==============================================================================
# 5. RATE LIMITING & ABUSE PROTECTION (OPTIONAL)
# ==============================================================================
# [Optional] Sliding window rate limits (currently instance-local MemoryRateLimiterStore)
RATE_LIMIT_RESOLVE_PER_MINUTE=20
RATE_LIMIT_DOWNLOAD_PER_MINUTE=10
RATE_LIMIT_BATCH_PER_MINUTE=5
RATE_LIMIT_WINDOW_SECONDS=60

# [Optional] Maximum JSON body size in bytes (HTTP 413)
MAX_BODY_SIZE_BYTES=65536
# [Optional] Maximum URI length in characters (HTTP 414)
MAX_URL_LENGTH=2048

# [Optional] Circuit Breaker Protection against cascading upstream failures
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# [Optional] Cloudflare Turnstile Bot Challenge Secret Key (leave empty to disable challenge)
TURNSTILE_SECRET_KEY=

# ==============================================================================
# 6. CACHE & PERFORMANCE CONFIGURATION (OPTIONAL)
# ==============================================================================
# [Optional] Instance-local resolve cache with single-flight request coalescing
RESOLVE_CACHE_ENABLED=true
RESOLVE_CACHE_TTL_SECONDS=300
NEGATIVE_CACHE_TTL_SECONDS=60
RESOLVE_CACHE_MAX_ENTRIES=1000

# ==============================================================================
# 7. UPSTREAM PROVIDER API KEYS (REQUIRED FOR LIVE PLATFORMS)
# ==============================================================================
# Enter your authorized RapidAPI keys below. If omitted, providers safely return PROVIDER_NOT_CONFIGURED.

# --- TIKTOK PROVIDER ---
TIKTOK_PROVIDER_API_KEY=
TIKTOK_PROVIDER_API_HOST=tiktok-downloader-download-tiktok-videos-without-watermark.p.rapidapi.com
TIKTOK_PROVIDER_BASE_URL=https://tiktok-downloader-download-tiktok-videos-without-watermark.p.rapidapi.com
TIKTOK_RESOLVE_TIMEOUT_MS=8000
TIKTOK_MAX_RETRIES=2

# --- INSTAGRAM PROVIDER ---
INSTAGRAM_PROVIDER_API_KEY=
INSTAGRAM_PROVIDER_API_HOST=instagram-post-reels-stories-downloader-api.p.rapidapi.com
INSTAGRAM_PROVIDER_BASE_URL=https://instagram-post-reels-stories-downloader-api.p.rapidapi.com
INSTAGRAM_RESOLVE_TIMEOUT_MS=10000
INSTAGRAM_MAX_RETRIES=2

# --- YOUTUBE PROVIDER ---
YOUTUBE_PROVIDER_API_KEY=
YOUTUBE_PROVIDER_API_HOST=youtube-video-and-shorts-downloader.p.rapidapi.com
YOUTUBE_PROVIDER_BASE_URL=https://youtube-video-and-shorts-downloader.p.rapidapi.com
YOUTUBE_RESOLVE_TIMEOUT_MS=10000
YOUTUBE_MAX_RETRIES=2

# --- X / TWITTER PROVIDER ---
X_PROVIDER_API_KEY=
X_PROVIDER_API_HOST=twitter-video-downloader2.p.rapidapi.com
X_PROVIDER_BASE_URL=https://twitter-video-downloader2.p.rapidapi.com
X_RESOLVE_TIMEOUT_MS=10000
